{
  "extends": "@entwine/config/tsconfig/react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": ["next-env.d.ts", "src", "next.config.ts", "eslint.config.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
