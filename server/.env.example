# Port the API listens on. Defaults to 8080 when unset.
PORT=8080

# Local Docker Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgres://entwine:entwine@localhost:5432/entwine?sslmode=disable

# Supabase project settings → API. Auth only; no application data lives there.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Browser origin allowed to call this API.
APP_ORIGIN=http://localhost:5173

# Google AI Studio → API keys. Free tier; used to parse uploaded resumes.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
